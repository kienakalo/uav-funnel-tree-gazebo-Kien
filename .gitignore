# Local environments, bytecode and temporary application files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
*.log
*.pid
.DS_Store
Thumbs.db

# Rebuildable exports and archives.
/output/
*.zip

# The city asset is tracked once, at data/source/city.glb. Copies downloaded
# into the legacy data/input location stay local.
/data/input/city.glb

# Keep a curated set of checked inputs and results. Other generated data,
# profiling dumps, runtime packages and large propagation caches stay local.
